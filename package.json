  },
  "browserslist": "since 2016",
  "devDependencies": {
    "@parcel/transformer-inline-string": "2.16.4",
    "parcel": "~2.16.4",
    "parcel-reporter-static-files-copy": "~1.4.0",
    "push-dir": "~0.4.1",
    "rimraf": "~6.1.3"
  },
  "dependencies": {
    "attodom": "~0.13.1",
    "file-saver": "~2.0.5",
    "flyd": "~0.2.8",
    "nanoid": "~3.3.17",
    "ngraph.graph": "~19.1.0",
    "openpgp": "~5.4.0"
  }
}
